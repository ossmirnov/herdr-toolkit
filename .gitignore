# This folder is the Herdr app's home (~/.config/herdr-app). The app rewrites
# most of it on every start and writes state while it runs; only our own mods,
# layouts and settings belong in git. Shipped mods and layouts are listed by
# name below: when a Herdr update ships a new one, it shows up untracked here
# and belongs on that list.

# Written by the app on every start
/AGENTS.md
/*.d.ts
/mods/*/*.d.ts
/mods/*/jsconfig.json
/frame/
/icons/
/themes/atom-one-dark.json
/themes/win98.json

# State, bookkeeping, logs, things set aside
/view.json
/shared.json
/seen.json
/installed.json
/window.json
/windows.json
/update-notes.json
/update-notes-cache.md
/update-notes-media/
/telemetry/
/data/
/layouts/.state/
/herdr-app.sock
*.log
*.error
*.reset-*
*.old-*
*.corrupt-*
/mods/*-edited*/
/layouts/*-edited*.json

# Herdr's own layouts and mods (replaced whole on every start)
/layouts/main.json
/layouts/terminals.json
/layouts/win98.json
/layouts/win98.svg
/mods/agents/
/mods/changes/
/mods/confirm/
/mods/files/
/mods/help/
/mods/machine-add/
/mods/menu/
/mods/new-menu/
/mods/pane/
/mods/peek/
/mods/picker/
/mods/prompt/
/mods/spaces/
/mods/tabs/
/mods/terminals-bar/
/mods/terminals-pane/
/mods/toast/
/mods/win98/
/mods/workspace-chrome/
/mods/workspace-status/
/mods/worktree/
